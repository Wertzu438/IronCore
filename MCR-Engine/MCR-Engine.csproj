<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MCR_Engine</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>MCR.Engine</PackageId>
    <Version>1.0.0</Version>
    <Authors>Simon Straubinger</Authors>
    <Company>MCR</Company>

    <Description>2D Game Engine for .NET</Description>
    <PackageTags>game engine;2d;gamedev</PackageTags>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
</PropertyGroup>

</Project>
