<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\MCR-Engine\MCR-Engine.csproj" />
    </ItemGroup>
    <Target Name="CopyApplicationData" AfterTargets="Build">
        <Copy SourceFiles="@(AppDataFiles)"
              DestinationFiles="@(AppDataFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <ItemGroup>
        <AppDataFiles Include="ApplicationData\**\*" />
    </ItemGroup>


</Project>
