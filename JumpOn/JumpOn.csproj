<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup>
        <Company>Abbas GmbH</Company>
        <Authors>Simon Straubinger</Authors>
        <Product>JumpOn</Product>
        <Copyright>Copyright © 2026 Simon Straubinger.</Copyright>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\MCR-Engine\MCR-Engine.csproj" />
    </ItemGroup>
    <Target Name="CopyApplicationData" AfterTargets="Build">
        <Copy SourceFiles="@(AppDataFiles)"
              DestinationFiles="@(AppDataFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <ItemGroup>
        <AppDataFiles Include="ApplicationData\**\*" />
    </ItemGroup>
    <PropertyGroup>
        <ApplicationIcon>ApplicationData\Icon.ico</ApplicationIcon>
    </PropertyGroup>


</Project>
